    "Ember" : {
      "comment" : "The name of the app.",
      "isCommentAutoGenerated" : true
    },
    "Ember speaks with the person who answers. You can reply to questions on screen or send instructions." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember conversa con la persona que contesta. Puedes responder preguntas en pantalla o enviar instrucciones."
          }
        }
      }
    },
    "Ember waits for the person who answers to say hello." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember espera a que la persona que contesta salude."
          }
        }
      }
    },
    "Ember will ask when a name is needed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember te preguntará si necesita un nombre."
          }
        }
      }
    },
    "Ember will call this number and speak for you. Your iPhone microphone and speaker are not used. Keep the app in the foreground." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember llamará a este número y hablará por ti. No se usan el micrófono ni el altavoz del iPhone. Mantén la app en primer plano."
          }
        }
      }
    },
    "Ember will use this language for its screens and for questions it asks you. The phone conversation language is configured separately for each call." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember usará este idioma en sus pantallas y en las preguntas que te haga. El idioma de la conversación telefónica se configura por separado para cada llamada."
          }
        }
      }
    },
